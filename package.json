{
  "name": "com.akylas.bpxcel2pdf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akylas/bpxcel2pdf.git"
  },
  "type": "module",
  "author": {
    "name": "Martin Guillon",
    "email": "martin@akylas.fr"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/Akylas/bpxcel2pdf/issues"
  },
  "homepage": "https://github.com/Akylas/bpxcel2pdf#readme",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "prettier": {
    "printWidth": 100,
    "semi": true,
    "singleQuote": true
  },
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "tauri": "tauri",
    "build": "tauri build",
    "build:web": "vite build",
    "test": "cargo test --manifest-path ./src-tauri/Cargo.toml",
    "format": "prettier --write src *.js *.ts *.mjs && eslint --fix src *.js *.ts *.mjs",
    "check": "cargo check --manifest-path src-tauri/Cargo.toml && eslint src *.js && svelte-check",
    "release": "standard-version --commit-all --preset angular"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/cli": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.3.5",
    "@tauri-apps/toml": "^2.2.4",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "cssnano": "^7.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-svelte": "^3.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.0.0",
    "sass": "^1.77.0",
    "standard-version": "^9.5.0",
    "svelte": "^5.55.4",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.0.9"
  },
  "dependencies": {
    "@tauri-apps/plugin-process": "^2.3.1",
    "carbon-components": "10.58.15",
    "carbon-components-svelte": "^0.106.2",
    "carbon-icons-svelte": "^13.10.0",
    "convert-excel-to-json": "^1.7.0",
    "events": "^3.3.0",
    "svelte-i18n": "^3.5.2",
    "svelte-tauri-filedrop": "^2",
    "xlsx": "^0.18.5"
  },
  "version": "1.1.0"
}
